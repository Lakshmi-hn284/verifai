# ==============================================================================
# VERIFAI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust values for your environment.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Environment Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="VERIFAI"
PROJECT_VERSION="1.0.0-prototype"
ENVIRONMENT="development"        # Options: development | testing | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# 2. Cryptographic Keys & Authentication Secrets
# ------------------------------------------------------------------------------
# JWT Signing Key (Must be at least 32 characters long in production)
# Generate a secure key using: openssl rand -base64 32
SECRET_KEY="verifai-dev-insecure-secret-key-change-in-production-32chars!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours for development
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM Vault Master Key (Must be 32 bytes encoded as 64 hex characters)
# Generate a secure key using: openssl rand -hex 32
VAULT_MASTER_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Local Vault Encrypted Storage Directory
VAULT_STORAGE_PATH="./vault_storage"

# ------------------------------------------------------------------------------
# 3. Database Configuration (Dual-Mode: SQLite or PostgreSQL)
# ------------------------------------------------------------------------------
# Default: Zero-dependency local async SQLite database
DATABASE_URL="sqlite+aiosqlite:///./verifai.db"

# Optional: PostgreSQL with pgvector (for Docker Compose or production deployment)
# DATABASE_URL="postgresql+asyncpg://verifai:verifai_dev_secret@localhost:5432/verifai"
POSTGRES_USER="verifai"
POSTGRES_PASSWORD="verifai_dev_secret"
POSTGRES_DB="verifai"

# ------------------------------------------------------------------------------
# 4. Knowledge Graph Configuration (Dual-Mode: NetworkX or Neo4j)
# ------------------------------------------------------------------------------
# When true, uses embedded NetworkX graph provider with JSON persistence.
# Set to false to connect to Neo4j.
USE_LOCAL_GRAPH=true

# Neo4j Settings (used when USE_LOCAL_GRAPH=false)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="verifai_neo4j_dev_secret"

# ------------------------------------------------------------------------------
# 5. AI / LLM Provider Configuration
# ------------------------------------------------------------------------------
# Default provider ('mock' runs deterministic heuristics without external APIs)
DEFAULT_LLM_PROVIDER="mock"

# Optional: External LLM API Keys (set only if integrating live LLMs)
# GEMINI_API_KEY="your-gemini-api-key-here"
# OPENAI_API_KEY="your-openai-api-key-here"

# ------------------------------------------------------------------------------
# 6. Networking & CORS
# ------------------------------------------------------------------------------
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Frontend Public API URL (consumed by client browser in Next.js)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
