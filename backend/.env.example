# VERIFAI Backend Environment Configuration Template
# For detailed configuration, refer to the root .env.example

PROJECT_NAME="VERIFAI"
PROJECT_VERSION="1.0.0-prototype"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Cryptography & Security
SECRET_KEY="verifai-dev-insecure-secret-key-change-in-production-32chars!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM Vault Key (32 bytes hex encoded)
VAULT_MASTER_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
VAULT_STORAGE_PATH="./vault_storage"

# Database & Graph
DATABASE_URL="sqlite+aiosqlite:///./verifai.db"
USE_LOCAL_GRAPH=true
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="verifai_neo4j_dev_secret"

# Optional AI Providers
DEFAULT_LLM_PROVIDER="mock"
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""

CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
